{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalDependencies": [
    "patches/**",
    "bunfig.toml",
    ".npmrc",
    ".github/actions/setup-bun/**",
    ".github/workflows/test.yml",
    "package.json"
  ],
  "globalEnv": ["CI", "MODTOOLS_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "MODTOOLS_DISABLE_SHARE"],
  "tasks": {
    // `transit` folds every workspace dependency into the hash, so a change in a dependency re-checks its dependents
    // instead of replaying their cached result. Local `typecheck` runs `bun check`, which reads dependency sources
    // directly and needs no build order.
    "typecheck": {
      "dependsOn": ["transit"]
    },
    // CI checks types with the official TypeScript compiler. tsc -b writes core's declarations for the packages that
    // reference it, so those packages also wait for core. Package entries replace the generic one, so they repeat
    // `transit`.
    "typecheck:tsc": {
      "dependsOn": ["transit"]
    },
    "@modtools-ai/cli#typecheck:tsc": {
      "dependsOn": ["transit", "@modtools-ai/core#typecheck:tsc"]
    },
    "@modtools-ai/sdk#typecheck:tsc": {
      "dependsOn": ["transit", "@modtools-ai/core#typecheck:tsc"]
    },
    "@modtools-ai/server#typecheck:tsc": {
      "dependsOn": ["transit", "@modtools-ai/core#typecheck:tsc"]
    },
    "@modtools-ai/simulation#typecheck:tsc": {
      "dependsOn": ["transit", "@modtools-ai/core#typecheck:tsc"]
    },
    "@modtools-ai/tui#typecheck:tsc": {
      "dependsOn": ["transit", "@modtools-ai/core#typecheck:tsc"]
    },
    "test:components": {
      "outputs": [],
      "cache": false
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["dist/**"]
    },
    // Workspace packages export their sources, so tests never wait for a dependency's build; the build job in
    // test.yml checks the library builds. No package has a transit script: it runs nothing and only folds every
    // workspace dependency into the test hash.
    "transit": {
      "dependsOn": ["^transit"]
    },
    // Every package with a test script runs here, so a new suite cannot be left out of CI.
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@modtools-ai/desktop#test": {
      "outputs": [],
      "cache": false
    },
    "@modtools-ai/sdk#verify:package": {
      "outputs": []
    }
  }
}
